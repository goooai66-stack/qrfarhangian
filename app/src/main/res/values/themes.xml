<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose background: no white flash on cold start. -->
    <style name="Theme.Hesabyar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_beige</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/bg_beige</item>
    </style>
    <color name="bg_beige">#FFF9F6F0</color>
    <color name="navy">#FF1B2A4A</color>
    <color name="bg_dark">#FF0F1524</color>
</resources>
