# کپی کنید به .env و پر کنید. فایل .env هرگز commit نشود.

# fake | anthropic | openai_compatible
VISION_PROVIDER=fake

# --- Claude (اگر VISION_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- هر سرویس سازگار با OpenAI (اگر VISION_PROVIDER=openai_compatible) ---
# OpenRouter: OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
#   و OPENAI_COMPAT_MODEL یک مدل با ورودی تصویر از openrouter.ai/models
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# اختیاری (OpenRouter): آدرس سایت/صفحه‌ی اپ و نام اپ
OPENAI_COMPAT_REFERER=
OPENAI_COMPAT_TITLE=CalorieLens

# قیمت هر میلیون توکن (دلار) برای لاگ هزینه
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

FREE_SCANS_PER_DAY=3
PREMIUM_SCANS_PER_DAY=30
SCANS_PER_MINUTE=6
QUOTA_TIMEZONE=Asia/Tehran
PROVIDER_TIMEOUT_SECONDS=20
CACHE_TTL_DAYS=7
DB_PATH=/data/calorielens.db
# در Docker، foods.json از ریشه‌ی پروژه کپی می‌شود.
FOODS_PATH=/app/foods.json

# پاداش ویدیو: هر ویدیوی کامل = ۱ اسکن، حداکثر در روز
REWARDS_PER_DAY=5
# fake = توکن‌های test- (فقط توسعه) | stores = API بازار/مایکت (هنوز وصل نشده)
PURCHASE_VERIFIER=fake
# شناسه‌ی محصول در فروشگاه = تعداد روز ویژه (با lib/core/billing یکی باشد)
PRODUCT_DAYS=premium_monthly=30,premium_quarterly=90,premium_yearly=365

# خالی = /admin/stats خاموش
ADMIN_TOKEN=
